# Fresh, SEPARATE Supabase project for the Skalora cockpit — do NOT reuse any existing project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge Function: prospector (Faza 3, opcjonalne) ---
# Ustaw w sekretach Supabase (Project Settings -> Edge Functions), NIE w tym pliku:
#   ANTHROPIC_API_KEY=sk-ant-...   # bez niego agent użyje heurystyki
#   ANTHROPIC_MODEL=claude-opus-4-8 (domyślnie; np. claude-haiku-4-5 dla niższego kosztu)
#   ICP_THRESHOLD=60

# --- Wysyłka maili (Edge Function send-outreach) ---
# Sekrety w Supabase (Edge Functions -> Secrets), NIE w tym pliku:
#   RESEND_API_KEY=re_...        # bez niego send-outreach działa w trybie dry_run (status 'sent' bez realnej wysyłki)
#   RESEND_FROM="Skalora <kontakt@skalora.pl>"   # nadawca z domeny zweryfikowanej w Resend
#   BOOKING_URL=https://cal.com/...   # opcjonalny CTA z trackingiem kliknięć
